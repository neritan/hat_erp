# Copy to .env and change the passwords. Never commit .env.
SITE_NAME=hat.localhost
ADMIN_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
HTTP_PORT=8080
ERPNEXT_VERSION=v16.37.0
# Local builds use neritan/hat:dev; on the dev server the pipeline writes HAT_IMAGE (ghcr.io).
# HAT_IMAGE=ghcr.io/neritan/hat:dev
# S3 object storage for uploaded files (leave empty to keep files on the server disk).
# S3_URL is the bucket address, e.g. https://hatix.nbg1.your-objectstorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_URL=
# HTTPS with Caddy and Let's Encrypt (ports 80 and 443 must be open). PUBLIC_HOST is a domain
# pointing to the server, or its public IP (Let's Encrypt then issues ~6-day certificates that
# Caddy renews by itself). Leave these out to keep plain HTTP on HTTP_PORT.
# COMPOSE_PROFILES=https
# PUBLIC_HOST=2.31.138.132
# TRUST_UPSTREAM_FORWARDED_PROTO=on
# With HTTPS, Caddy takes port 8080 to redirect old http://<host>:8080 links to HTTPS, so nginx
# moves to a port reachable only from the server itself:
# HTTP_PORT=127.0.0.1:8081
