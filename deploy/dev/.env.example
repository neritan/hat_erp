# Copy to .env and change the passwords. Never commit .env.
SITE_NAME=hat.localhost
ADMIN_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
HTTP_PORT=8080
ERPNEXT_VERSION=v16.37.0
# Local builds use neritan/hat:dev; on the dev server the pipeline writes HAT_IMAGE (ghcr.io).
# HAT_IMAGE=ghcr.io/neritan/hat:dev
# S3 object storage for uploaded files (leave empty to keep files on the server disk).
# S3_URL is the bucket address, e.g. https://hatix.nbg1.your-objectstorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_URL=
